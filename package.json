{
  "name": "bytecode-ai",
  "version": "1.1.2",
  "type": "module",
  "description": "ByteCode — multi-provider agent harness with Claude Code semantics and an opencode-style provider layer",
  "keywords": [
    "agent",
    "ai",
    "cli",
    "coding-agent",
    "llm",
    "mcp",
    "terminal",
    "tui"
  ],
  "license": "MIT",
  "author": "Abel Duarte",
  "homepage": "https://github.com/abelduartek/ByteCode#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abelduartek/ByteCode.git"
  },
  "bugs": {
    "url": "https://github.com/abelduartek/ByteCode/issues"
  },
  "bin": {
    "bytecode": "bin/bytecode.mjs"
  },
  "files": [
    "bin",
    "dist",
    "workflows"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "bun:bytecode": "bun src/index.ts",
    "bytecode": "node --experimental-strip-types src/index.ts",
    "check": "npm run typecheck && npm test",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "test": "node test/run.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.23",
    "@ai-sdk/openai-compatible": "^3.0.16",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ai": "^7.0.41",
    "undici": "^8.10.0"
  },
  "optionalDependencies": {
    "@vscode/ripgrep": "^1.15.14"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
